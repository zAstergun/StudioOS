  (window as any).downloadHistory = function(items: any[], format: string) {
    if (!items || items.length === 0) {
      alert('Nada para exportar.');
      return;
    }

    let content = '';
    let mimeType = 'text/plain';
    
    if (format === 'doc') {
      mimeType = 'application/msword';
      content = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
        <head><meta charset='utf-8'><title>Histórico de IA</title></head><body>
      `;
      items.forEach((item: any) => {
        const dateStr = new Date(item.date).toLocaleString('pt-BR');
        let htmlResult = '';
        try {
          htmlResult = (window as any).marked ? (window as any).marked.parse(item.result) : item.result.replace(/\n/g, '<br>');
        } catch(e) {
          htmlResult = item.result.replace(/\n/g, '<br>');
        }
        content += `
          <h2 style="font-family: sans-serif; color: #333;">Ferramenta: ${item.tool}</h2>
          <p style="font-family: sans-serif; font-size: 12px; color: #666;">Gerado em: ${dateStr}</p>
          <h3 style="font-family: sans-serif; color: #555;">Contexto / Prompt:</h3>
          <p style="font-family: sans-serif; background: #f4f4f4; padding: 10px;">${item.prompt.replace(/\n/g, '<br>')}</p>
          <h3 style="font-family: sans-serif; color: #555;">Resultado:</h3>
          <div style="font-family: sans-serif;">${htmlResult}</div>
          <hr style="margin: 30px 0;">
        `;
      });
      content += `</body></html>`;
    } else {
      items.forEach((item: any) => {
        const dateStr = new Date(item.date).toLocaleString('pt-BR');
        content += `# Ferramenta: ${item.tool}\n`;
        content += `Gerado em: ${dateStr}\n\n`;
        content += `## Contexto / Prompt\n${item.prompt}\n\n`;
        content += `## Resultado\n${item.result}\n\n`;
        content += `---\n\n`;
      });
    }

    const filename = items.length === 1 
      ? `StudioOS_${items[0].tool.replace(/\s+/g, '_')}.${format}` 
      : `StudioOS_Historico_IA.${format}`;

    const blob = new Blob([content], { type: mimeType });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', filename);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  };

