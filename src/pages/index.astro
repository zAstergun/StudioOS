              </select>
              <button class="btn custom-select-btn" id="btn-period-select-trash">
                <span class="selected-text">Todo Período</span>
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="opacity: 0.5;"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="dropdown-menu">
                <div class="dropdown-item active" data-value="all">Todo Período</div>
                <div class="dropdown-item" data-value="today">Hoje</div>
                <div class="dropdown-item" data-value="7days">Últimos 7 dias</div>
