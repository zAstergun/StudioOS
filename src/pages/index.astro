        <div id="lixeira-empty" class="text-secondary" style="text-align: center; margin-top: 40px; padding: 40px; background: var(--bg-elevated); border-radius: 12px; border: 1px dashed var(--border);">
          <svg style="width: 56px; height: 56px; margin: 0 auto 12px; opacity: 0.4;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          <p>A lixeira está vazia.</p>
        </div>

        <div id="lixeira-list" class="grid grid-1" style="gap: 16px; display: none;">
          <!-- Items inserted via JS -->
        </div>
      </div>

      <!-- ================================ -->
      <!-- VIEW: CONFIGURAÇÕES              -->
      <!-- ================================ -->
      <div id="view-config" class="view-section">
        <div class="page-header">
          <h1 class="display">Configurações</h1>
          <p class="text-secondary">Conecte sua Inteligência Artificial via chave de API.</p>
        </div>
        <div class="card" style="max-width: 600px;">
          <div class="form-group">
            <label class="form-label">Provedor de IA</label>
