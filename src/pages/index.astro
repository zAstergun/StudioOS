      const target = document.getElementById('view-historico');
      if (target) target.classList.add('active');
    });
    
    document.getElementById('btn-esvaziar-lixeira')?.addEventListener('click', () => {
      if (confirm('Tem certeza que deseja esvaziar a lixeira pra sempre?')) {
        localStorage.removeItem('ai_history_trash');
        (window as any).renderTrash();
      }
    });

    // Initialize Flatpickr for custom calendars
    if (typeof (window as any).flatpickr !== 'undefined') {
      const now = new Date();
      const sevenDaysAgo = new Date();
      sevenDaysAgo.setDate(now.getDate() - 7);

      const Portuguese = {
        weekdays: {
          shorthand: ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"],
          longhand: ["Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira", "Sábado"]
        },
        months: {
          shorthand: ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez"],
          longhand: ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"]
        },
        rangeSeparator: " até ",
        time_24hr: true
      };

      function centerCalendar(instance: any) {
        if (!instance || !instance.calendarContainer) return;
        const input = instance.altInput || instance.input;
        if (!input) return;
        const inputRect = input.getBoundingClientRect();
        const cal = instance.calendarContainer;
        const inputCenter = inputRect.left + (inputRect.width / 2) + window.scrollX;
        const calWidth = cal.offsetWidth || 324;
        let targetLeft = Math.round(inputCenter - (calWidth / 2));
        
        const maxLeft = window.innerWidth - calWidth - 10;
        if (targetLeft < 10) targetLeft = 10;
        if (targetLeft > maxLeft) targetLeft = maxLeft;

        cal.style.left = targetLeft + 'px';
        cal.style.right = 'auto';
      }

      function applySlideAnimation(instance: any) {
        if (!instance || !instance.calendarContainer) return;
        const cal = instance.calendarContainer;
        const btnSpan = cal.querySelector('.flatpickr-month-btn span');

        const prev = instance._lastMonthYear || { month: instance.currentMonth, year: instance.currentYear };
        const prevIndex = prev.year * 12 + prev.month;
        const currIndex = instance.currentYear * 12 + instance.currentMonth;
        instance._lastMonthYear = { month: instance.currentMonth, year: instance.currentYear };

        if (currIndex === prevIndex) return;

        const animClass = currIndex > prevIndex ? 'slide-next' : 'slide-prev';

        requestAnimationFrame(() => {
          const dayContainer = cal.querySelector('.dayContainer');
          if (dayContainer) {
            dayContainer.classList.remove('slide-next', 'slide-prev');
            void dayContainer.offsetWidth;
            dayContainer.classList.add(animClass);
          }
          if (btnSpan) {
            btnSpan.classList.remove('slide-next', 'slide-prev');
            void btnSpan.offsetWidth;
            btnSpan.classList.add(animClass);
          }
        });
      }

      const fpConfig = {
        enableTime: true,
        dateFormat: "Y-m-d\\TH:i",
        altInput: true,
        altFormat: "d/m/Y H:i",
        locale: Portuguese,
        time_24hr: true,
        allowInput: true,
        animate: true,
        onOpen: function(selectedDates: any, dateStr: any, instance: any) {
          instance._lastMonthYear = { month: instance.currentMonth, year: instance.currentYear };
          document.querySelectorAll('.flatpickr-calendar.open').forEach((cal: any) => {
            if (cal !== instance.calendarContainer) {
              if (cal._flatpickr) cal._flatpickr.close();
              cal.classList.remove('open');
            }
          });
          centerCalendar(instance);
          setTimeout(() => centerCalendar(instance), 10);
        },
        onChange: function() {
          if (document.getElementById('view-historico')?.classList.contains('active')) {
            (window as any).renderHistory();
          } else {
            (window as any).renderTrash();
          }
        },
        onMonthChange: function(selectedDates: any, dateStr: any, instance: any) {
          const btnSpan = instance.calendarContainer?.querySelector('.flatpickr-month-btn span');
          if (btnSpan && instance.l10n.months.longhand[instance.currentMonth]) {
            btnSpan.textContent = instance.l10n.months.longhand[instance.currentMonth];
          }
          applySlideAnimation(instance);
        },
        onYearChange: function(selectedDates: any, dateStr: any, instance: any) {
          const btnSpan = instance.calendarContainer?.querySelector('.flatpickr-month-btn span');
          if (btnSpan && instance.l10n.months.longhand[instance.currentMonth]) {
            btnSpan.textContent = instance.l10n.months.longhand[instance.currentMonth];
          }
          applySlideAnimation(instance);
        },
        onClose: function(selectedDates: any, dateStr: any, instance: any) {
          instance.calendarContainer?.querySelectorAll('.flatpickr-dropdown-menu.show').forEach((m: any) => m.classList.remove('show'));
        },
        onReady: function(selectedDates: any, dateStr: any, instance: any) {
          instance._lastMonthYear = { month: instance.currentMonth, year: instance.currentYear };
          const originalPosition = instance.positionCalendar;
          instance.positionCalendar = function(customPosElem: any) {
            if (originalPosition) originalPosition.call(instance, customPosElem);
            centerCalendar(instance);
          };

          // Custom Year Dropdown + Typable Input
          if (instance.currentYearElement) {
            const numInputWrapper = instance.currentYearElement.parentNode as HTMLElement;
            if (numInputWrapper) {
              // Add custom toggle button
              const yearToggle = document.createElement('div');
              yearToggle.className = 'flatpickr-year-toggle';
              yearToggle.title = 'Escolher ano';
              yearToggle.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>`;
              numInputWrapper.appendChild(yearToggle);

              // Create year dropdown menu
              const yearMenu = document.createElement('div');
              yearMenu.className = 'flatpickr-dropdown-menu';

              const currentYear = new Date().getFullYear();
              for (let i = currentYear - 15; i <= currentYear + 15; i++) {
                const item = document.createElement('div');
                item.className = 'dropdown-item';
                item.textContent = i.toString();
                item.addEventListener('click', (e: any) => {
                  e.stopPropagation();
                  instance.changeYear(i);
                  yearMenu.classList.remove('show');
                });
                yearMenu.appendChild(item);
              }
              numInputWrapper.appendChild(yearMenu);

              yearToggle.addEventListener('click', (e: any) => {
                e.preventDefault();
                e.stopPropagation();
                const isShowing = yearMenu.classList.contains('show');
                document.querySelectorAll('.dropdown-menu.show, .flatpickr-dropdown-menu.show').forEach((m: any) => m.classList.remove('show'));
                if (!isShowing) {
                  yearMenu.querySelectorAll('.dropdown-item').forEach((it: any) => {
                    if (it.textContent === instance.currentYear.toString()) {
                      it.classList.add('active');
                      setTimeout(() => it.scrollIntoView({ block: 'nearest' }), 10);
                    } else {
                      it.classList.remove('active');
                    }
                  });
                  yearMenu.classList.add('show');
                }
              });
            }
          }

          // Custom Month Dropdown replacement
          const monthSelect = instance.monthElements[0];
          if (monthSelect) {
            monthSelect.style.display = 'none';

            const monthWrapper = document.createElement('div');
            monthWrapper.className = 'custom-flatpickr-month-dropdown';

            const btn = document.createElement('div');
            btn.className = 'flatpickr-month-btn dropdown-toggle';
            btn.title = 'Escolher mês';
            btn.innerHTML = `<span>${instance.l10n.months.longhand[instance.currentMonth]}</span> <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>`;
            
            const menu = document.createElement('div');
            menu.className = 'flatpickr-dropdown-menu';
            
            instance.l10n.months.longhand.forEach((m: string, idx: number) => {
              const item = document.createElement('div');
              item.className = 'dropdown-item';
              item.textContent = m;
              item.addEventListener('click', (e: any) => {
                e.stopPropagation();
                instance.changeMonth(idx, false);
                const btnSpan = btn.querySelector('span');
                if (btnSpan) btnSpan.textContent = m;
                menu.classList.remove('show');
              });
              menu.appendChild(item);
            });

            monthWrapper.appendChild(btn);
            monthWrapper.appendChild(menu);
            monthSelect.parentNode.insertBefore(monthWrapper, monthSelect);

            btn.addEventListener('click', (e: any) => {
              e.preventDefault();
              e.stopPropagation();
              const isShowing = menu.classList.contains('show');
              document.querySelectorAll('.dropdown-menu.show, .flatpickr-dropdown-menu.show').forEach((m: any) => m.classList.remove('show'));
              if (!isShowing) {
                menu.querySelectorAll('.dropdown-item').forEach((it: any, idx: number) => {
                  if (idx === instance.currentMonth) {
                    it.classList.add('active');
                    setTimeout(() => it.scrollIntoView({ block: 'nearest' }), 10);
                  } else {
                    it.classList.remove('active');
                  }
                });
                menu.classList.add('show');
              }
            });
          }
        }
      };
      
      (window as any).flatpickr("#custom-date-start", { ...fpConfig, defaultDate: sevenDaysAgo });
      (window as any).flatpickr("#custom-date-end", { ...fpConfig, defaultDate: now });
      (window as any).flatpickr("#custom-date-start-trash", { ...fpConfig, defaultDate: sevenDaysAgo });
      (window as any).flatpickr("#custom-date-end-trash", { ...fpConfig, defaultDate: now });
    }
  });
</script>
</Layout>
