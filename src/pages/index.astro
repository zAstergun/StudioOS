    (window as any).renderTrash();
    
    // Logic for custom dropdowns
    document.querySelectorAll('.custom-select').forEach(wrapper => {
      const btn = wrapper.querySelector('.custom-select-btn') as HTMLElement;
      const menu = wrapper.querySelector('.dropdown-menu') as HTMLElement;
      const items = wrapper.querySelectorAll('.dropdown-item');
      const select = wrapper.querySelector('select') as HTMLSelectElement;
      const textSpan = btn.querySelector('.selected-text') as HTMLElement;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
