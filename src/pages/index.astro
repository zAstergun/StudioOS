---
import { createSupabaseClient } from '../studio/lib/supabase';
import Layout from '../layouts/Layout.astro';
import StudioClient from '../studio/StudioClient';

const runtime = (Astro.locals as any).runtime;
const env = runtime?.env ?? import.meta.env;

const supabaseUrl = env.PUBLIC_SUPABASE_URL;
const supabaseKey = env.PUBLIC_SUPABASE_ANON_KEY;

if (!supabaseUrl || !supabaseKey) {
  throw new Error("Variáveis do Supabase não encontradas no runtime.");
}

const supabase = createSupabaseClient(Astro.cookies, supabaseUrl, supabaseKey);

const { data, error } = await supabase.auth.getUser();

if (error || !data?.user) {
  return Astro.redirect('/login');
}

const userEmail = data.user.email;
---

<Layout title="StudioOS — Sistema Operacional do Criador">
  <StudioClient client:only="react" />
</Layout>
