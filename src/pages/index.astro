        <div class="card mt-24" style="max-width: 600px;">
          <h3 class="card-title mb-16">Histórico & Lixeira</h3>
          <div class="form-group">
            <label class="form-label">Manter itens na lixeira por:</label>
            <select class="form-control" id="trash-retention-select">
              <option value="0">Apagar na hora (não usar lixeira)</option>
              <option value="1">1 dia</option>
              <option value="7">7 dias (Padrão)</option>
              <option value="14">14 dias</option>
              <option value="30">30 dias</option>
            </select>
            <p class="text-secondary mt-8" style="font-size: 12px;">Itens apagados do histórico ficarão na lixeira pelo tempo selecionado antes de serem excluídos permanentemente.</p>
          </div>
          <button class="btn btn-primary" id="btn-save-trash-settings">Salvar Preferência</button>
        </div>
      </div>

    </main>
  </div>
</Layout>

<script is:inline define:vars={{ rankIdeiaSkill, humanizadorSkill, titulosSkill, hooksSkill, thumbnailSkill, roteiroSkill, receitaViralSkill, scorePostSkill, membrosSkill }}>
  window.SKILLS = {
    rankIdeia: rankIdeiaSkill,
    humanizador: humanizadorSkill,
    titulos: titulosSkill,
    hooks: hooksSkill,
    thumbnail: thumbnailSkill,
    roteiro: roteiroSkill,
    receitaViral: receitaViralSkill,
    scorePost: scorePostSkill,
    membros: membrosSkill
  };
</script>

<script>
  declare const marked: any;

  // ============================================
  // TOAST NOTIFICATIONS
  // ============================================
  function showToast(message: string, type: 'error' | 'success' | 'warning' = 'error') {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.style.position = 'fixed';
      container.style.top = '24px';
      container.style.right = '24px';
      container.style.zIndex = '9999';
      container.style.display = 'flex';
      container.style.flexDirection = 'column';
      container.style.gap = '12px';
      document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    const bgColors = { error: '#ef4444', success: '#10b981', warning: '#f59e0b' };
    toast.style.background = bgColors[type];
    toast.style.color = 'white';
    toast.style.padding = '14px 20px';
    toast.style.borderRadius = '8px';
    toast.style.boxShadow = '0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.1)';
    toast.style.fontSize = '14px';
    toast.style.fontWeight = '500';
    toast.style.opacity = '0';
    toast.style.transform = 'translateY(-20px)';
    toast.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
    toast.style.display = 'flex';
    toast.style.alignItems = 'center';
    toast.style.justifyContent = 'space-between';
    toast.style.gap = '16px';
    toast.style.maxWidth = '400px';

    const msgSpan = document.createElement('span');
    msgSpan.innerHTML = message;
    toast.appendChild(msgSpan);

    if (type === 'error' && (message.toLowerCase().includes('chave') || message.toLowerCase().includes('api') || message.toLowerCase().includes('ia'))) {
      const btn = document.createElement('button');
      btn.innerText = 'Configurar';
      btn.style.background = 'rgba(255,255,255,0.2)';
      btn.style.border = 'none';
      btn.style.color = 'white';
      btn.style.padding = '6px 12px';
      btn.style.borderRadius = '6px';
      btn.style.cursor = 'pointer';
      btn.style.fontSize = '13px';
      btn.style.fontWeight = '600';
      btn.style.whiteSpace = 'nowrap';
      
      btn.onmouseover = () => btn.style.background = 'rgba(255,255,255,0.3)';
      btn.onmouseout = () => btn.style.background = 'rgba(255,255,255,0.2)';
      
      btn.onclick = () => {
        const configBtn = document.querySelector('[data-view="view-config"]') as HTMLElement;
        if (configBtn) configBtn.click();
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      };
      toast.appendChild(btn);
    }

    container.appendChild(toast);
    
    requestAnimationFrame(() => {
      toast.style.opacity = '1';
      toast.style.transform = 'translateY(0)';
    });

    setTimeout(() => {
      if (toast.parentElement) {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-20px)';
        setTimeout(() => toast.remove(), 300);
      }
    }, 6000);
  }

  // ============================================
  // AI BACKEND (CLIENT-SIDE FETCH)
  // ============================================
  function getApiConfig() {
    return {
      provider: localStorage.getItem('ai_provider') || 'openai',
      key: localStorage.getItem('ai_api_key') || '',
      baseUrl: localStorage.getItem('ai_base_url') || '',
      model: localStorage.getItem('ai_model') || ''
    };
  }

  async function callAI(systemPrompt: string, userMessage: string, buttonElement: HTMLElement) {
    const config = getApiConfig();
    if (!config.key && config.provider !== 'custom') {
      showToast('⚠️ A Chave de API não foi configurada. Você precisa dela para usar a IA.', 'error');
      return null;
    }

    const originalText = buttonElement.innerText;
    buttonElement.innerText = 'Processando com IA...';
    buttonElement.setAttribute('disabled', 'true');

    try {
      let response;
      let resultText = '';

      if (['openai', 'groq', 'openrouter', 'deepseek', 'grok', 'custom'].includes(config.provider)) {
        let url = 'https://api.openai.com/v1/chat/completions';
        let model = 'gpt-4o';
        let headers: any = {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${config.key}`
        };
        
        if (config.provider === 'groq') {
          url = 'https://api.groq.com/openai/v1/chat/completions';
          model = 'llama3-70b-8192';
        } else if (config.provider === 'openrouter') {
          url = 'https://openrouter.ai/api/v1/chat/completions';
          model = 'anthropic/claude-3.5-sonnet'; // fallback default
          headers['HTTP-Referer'] = window.location.href;
          headers['X-Title'] = 'Painel de Conteúdo';
        } else if (config.provider === 'deepseek') {
          url = 'https://api.deepseek.com/chat/completions';
          model = 'deepseek-chat';
        } else if (config.provider === 'grok') {
          url = 'https://api.x.ai/v1/chat/completions';
          model = 'grok-beta';
        } else if (config.provider === 'custom') {
          url = config.baseUrl.trim();
          if (!url.endsWith('/chat/completions') && !url.endsWith('/messages')) {
            url = url.replace(/\/$/, '') + '/chat/completions';
          }
          model = config.model || 'default';
        }

        response = await fetch(url, {
          method: 'POST',
          headers: headers,
          body: JSON.stringify({
            model: model,
            messages: [
              { role: 'system', content: systemPrompt },
              { role: 'user', content: userMessage }
            ],
            temperature: 0.7
          })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error?.message || `Erro no provedor ${config.provider}`);
        resultText = data.choices[0].message.content;

      } else if (config.provider === 'anthropic') {
        response = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-api-key': config.key,
            'anthropic-version': '2023-06-01',
            'anthropic-dangerously-allow-browser': 'true'
          },
          body: JSON.stringify({
            model: 'claude-3-5-sonnet-20240620',
            max_tokens: 2000,
            system: systemPrompt,
            messages: [
              { role: 'user', content: userMessage }
            ],
            temperature: 0.7
          })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error?.message || 'Erro na Anthropic');
        resultText = data.content[0].text;

      } else if (config.provider === 'gemini') {
        response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${config.key}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            systemInstruction: { parts: [{ text: systemPrompt }] },
            contents: [{ role: 'user', parts: [{ text: userMessage }] }],
            generationConfig: { temperature: 0.7 }
          })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error?.message || 'Erro no Gemini');
        resultText = data.candidates[0].content.parts[0].text;
      }

      if (resultText) {
        try {
          const activeView = document.querySelector('.main-content > .view-section.active');
          const toolName = activeView?.querySelector('.display')?.textContent || 'Ferramenta IA';
          // Ignorar chamadas de teste de API
          if (userMessage !== 'Teste' && !systemPrompt.includes('assistente de teste')) {
            const historyRaw = localStorage.getItem('ai_history');
            const history = historyRaw ? JSON.parse(historyRaw) : [];
            history.unshift({
              id: Date.now().toString(),
              date: new Date().toISOString(),
              tool: toolName,
              prompt: userMessage,
              result: resultText
            });
            if (history.length > 50) history.pop();
            localStorage.setItem('ai_history', JSON.stringify(history));
            if (typeof (window as any).renderHistory === 'function') {
              (window as any).renderHistory();
            }
          }
        } catch(e) { console.error('Erro ao salvar histórico', e); }
      }

      return resultText;
    } catch (error: any) {
      showToast('⚠️ Erro na comunicação com a API da IA: ' + error.message, 'error');
      return null;
    } finally {
      buttonElement.innerText = originalText;
      buttonElement.removeAttribute('disabled');
    }
  }

  // ============================================
  // NAVIGATION
  // ============================================
  document.addEventListener('DOMContentLoaded', () => {
    // ============================================
    // MOBILE SIDEBAR TOGGLE
    // ============================================
    const sidebar = document.getElementById('sidebar')!;
    const overlay = document.getElementById('sidebar-overlay')!;
    const menuToggle = document.getElementById('menu-toggle')!;

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    menuToggle.addEventListener('click', openSidebar);
    overlay.addEventListener('click', closeSidebar);

    // Sidebar nav
    const navItems = document.querySelectorAll('.nav-item[data-view]');
    navItems.forEach(item => {
      item.addEventListener('click', () => {
        const viewId = item.getAttribute('data-view')!;
        switchView(viewId);
        navItems.forEach(n => n.classList.remove('active'));
        item.classList.add('active');
        localStorage.setItem('ai_active_view', viewId);
        closeSidebar();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    // Dashboard shortcuts
    document.querySelectorAll('[data-goto]').forEach(el => {
      el.addEventListener('click', () => {
        const viewId = el.getAttribute('data-goto')!;
        switchView(viewId);
        navItems.forEach(n => {
          n.classList.toggle('active', n.getAttribute('data-view') === viewId);
        });
        localStorage.setItem('ai_active_view', viewId);
      });
    });

    // Restore last active view
    const savedView = localStorage.getItem('ai_active_view');
    if (savedView) {
      switchView(savedView);
      navItems.forEach(n => {
        n.classList.toggle('active', n.getAttribute('data-view') === savedView);
      });
    }

    // Tab bars
    document.querySelectorAll('.tab-bar').forEach(bar => {
      bar.querySelectorAll('.tab-item').forEach(tab => {
        tab.addEventListener('click', () => {
          const tabId = tab.getAttribute('data-tab')!;
          const parent = bar.parentElement!;
          bar.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          parent.querySelectorAll(':scope > .view-section').forEach(s => s.classList.remove('active'));
          const target = parent.querySelector(`#${tabId}`);
          if (target) target.classList.add('active');
        });
      });
    });

    // ============================================
    // RANK DE IDEIA
    // ============================================
    let rankCalibrado = false;

    document.getElementById('btn-salvar-regua')?.addEventListener('click', () => {
      const nicho = (document.getElementById('rank-nicho') as HTMLInputElement).value;
      if (!nicho) { alert('Preencha o nicho do canal.'); return; }
      rankCalibrado = true;
      alert('Régua calibrada com sucesso!');
      // Switch to avaliador tab
      const parent = document.getElementById('view-rank-ideia')!;
      parent.querySelectorAll('.tab-item').forEach((t, i) => t.classList.toggle('active', i === 1));
      parent.querySelectorAll(':scope > .view-section').forEach(s => s.classList.remove('active'));
      document.getElementById('rank-avaliador')?.classList.add('active');
    });

    document.getElementById('btn-rankear')?.addEventListener('click', async () => {
      if (!rankCalibrado) {
        alert('Calibre o canal primeiro.');
        return;
      }
      const ideia = (document.getElementById('rank-ideia-input') as HTMLTextAreaElement).value;
      if (ideia.length < 10) { alert('Descreva com mais detalhes.'); return; }

      const btn = document.getElementById('btn-rankear')!;
      const nicho = (document.getElementById('rank-nicho') as HTMLInputElement).value;
      const videos = (document.getElementById('rank-videos') as HTMLTextAreaElement).value;
      
      const skill = (window as any).SKILLS.rankIdeia;
      const prompt = `Canal Nicho: ${nicho}\nHistórico: ${videos}\n\nIdeia para avaliar:\n${ideia}`;
      
      const response = await callAI(skill, prompt, btn);
      if (!response) return;

      document.getElementById('rank-empty')!.classList.add('hidden');
      document.getElementById('rank-result')!.classList.remove('hidden');
      document.getElementById('rank-result')!.innerHTML = `<div style="white-space: pre-wrap; line-height: 1.6; color: var(--text-secondary); text-align: left; margin-bottom: 24px;">${response}</div>`;

      updateStat('stat-ideias', 1);
    });

    // ============================================
    // HUMANIZADOR
    // ============================================
    const bannedWords = ['alavancar', 'otimizar', 'capacitar', 'desbloquear', 'impulsionar', 'sinergia', 'paradigma', 'jornada', 'farol', 'ecossistema', 'panorama', 'neste post vamos explorar', 'neste texto', 'em resumo', 'no geral', 'concluindo', 'abraçar'];

    document.getElementById('btn-auditar')?.addEventListener('click', async () => {
      const text = (document.getElementById('human-input') as HTMLTextAreaElement).value;
      if (text.trim().length < 10) { alert('Insira um texto maior.'); return; }

      const btn = document.getElementById('btn-auditar')!;
      const skill = (window as any).SKILLS.humanizador;
      
      const response = await callAI(skill, `Analise o seguinte texto e faça o diagnóstico completo:\n\n${text}`, btn);
      if (!response) return;

      document.getElementById('human-empty')!.classList.add('hidden');
      document.getElementById('human-result')!.classList.remove('hidden');
