  // ============================================
  // HISTÓRICO DE IA
  // ============================================
  (window as any).getFilteredHistory = function() {
    const historyRaw = localStorage.getItem('ai_history');
    let history = historyRaw ? JSON.parse(historyRaw) : [];
    
    const periodSelect = document.getElementById('history-period-select') as HTMLSelectElement;
    const period = periodSelect ? periodSelect.value : 'all';
    
    if (period !== 'all') {
      const now = new Date();
      now.setHours(0,0,0,0);
      
      history = history.filter((item: any) => {
        const itemDate = new Date(item.date);
        if (period === 'today') {
           itemDate.setHours(0,0,0,0);
           return itemDate.getTime() === now.getTime();
        } else if (period === '7days') {
           const cutoff = new Date(now);
           cutoff.setDate(cutoff.getDate() - 7);
           return itemDate >= cutoff;
        } else if (period === '30days') {
           const cutoff = new Date(now);
           cutoff.setDate(cutoff.getDate() - 30);
           return itemDate >= cutoff;
        } else if (period === 'custom') {
           const startInput = document.getElementById('custom-date-start') as HTMLInputElement;
           const endInput = document.getElementById('custom-date-end') as HTMLInputElement;
           const start = startInput && startInput.value ? new Date(startInput.value).getTime() : 0;
           let end = endInput && endInput.value ? new Date(endInput.value).getTime() : Infinity;
           
           return itemDate.getTime() >= start && itemDate.getTime() <= end;
        }
        return true;
      });
    }
    return history;
  };

  (window as any).getFilteredTrash = function() {
    const trashDays = parseInt(localStorage.getItem('ai_history_trash_days') || '7');
    const trashRaw = localStorage.getItem('ai_history_trash');
    let trash = trashRaw ? JSON.parse(trashRaw) : [];
    
    const nowAbs = Date.now();
    const cutoffAbs = nowAbs - (trashDays * 24 * 60 * 60 * 1000);
    trash = trash.filter((item: any) => item.deletedAt && item.deletedAt > cutoffAbs);
    localStorage.setItem('ai_history_trash', JSON.stringify(trash));
    
    const periodSelect = document.getElementById('trash-period-select') as HTMLSelectElement;
    const period = periodSelect ? periodSelect.value : 'all';
    
    if (period !== 'all') {
      const now = new Date();
      now.setHours(0,0,0,0);
      
      trash = trash.filter((item: any) => {
        const itemDate = new Date(item.date);
        if (period === 'today') {
           itemDate.setHours(0,0,0,0);
           return itemDate.getTime() === now.getTime();
        } else if (period === '7days') {
           const cutoff = new Date(now);
           cutoff.setDate(cutoff.getDate() - 7);
           return itemDate >= cutoff;
        } else if (period === '30days') {
           const cutoff = new Date(now);
           cutoff.setDate(cutoff.getDate() - 30);
           return itemDate >= cutoff;
        } else if (period === 'custom') {
           const startInput = document.getElementById('custom-date-start-trash') as HTMLInputElement;
           const endInput = document.getElementById('custom-date-end-trash') as HTMLInputElement;
           const start = startInput && startInput.value ? new Date(startInput.value).getTime() : 0;
           let end = endInput && endInput.value ? new Date(endInput.value).getTime() : Infinity;
           return itemDate.getTime() >= start && itemDate.getTime() <= end;
        }
        return true;
      });
    }
    return trash;
  };

  (window as any).renderHistory = function() {
    const historyList = document.getElementById('historico-list');
    const emptyState = document.getElementById('historico-empty');
