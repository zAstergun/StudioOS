    });
    
    document.getElementById('custom-date-start-trash')?.addEventListener('change', () => {
      (window as any).renderTrash();
    });
    
    document.getElementById('custom-date-end-trash')?.addEventListener('change', () => {
      (window as any).renderTrash();
    });
    
    const btnExportAll = document.getElementById('btn-export-all');
    const menuExportAll = document.getElementById('menu-export-all');
    
    btnExportAll?.addEventListener('click', (e) => {
      e.stopPropagation();
      document.querySelectorAll('.dropdown-menu.show').forEach(m => {
        if (m !== menuExportAll) m.classList.remove('show');
      });
      menuExportAll?.classList.toggle('show');
    });

    menuExportAll?.querySelectorAll('.dropdown-item').forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        menuExportAll?.classList.remove('show');
        const format = opt.getAttribute('data-format')!;
        const history = (window as any).getFilteredHistory();
        if (history && history.length > 0) {
          (window as any).downloadHistory(history, format);
        } else {
          alert('Nenhum item encontrado para exportar no período selecionado.');
        }
      });
    });

    document.getElementById('btn-limpar-historico')?.addEventListener('click', () => {
      if (confirm('Tem certeza que deseja apagar todo o histórico?')) {
        const trashDays = parseInt(localStorage.getItem('ai_history_trash_days') || '7');
        if (trashDays > 0) {
          const historyRaw = localStorage.getItem('ai_history');
          const history = historyRaw ? JSON.parse(historyRaw) : [];
          if (history.length > 0) {
            const trashRaw = localStorage.getItem('ai_history_trash');
            let trash = trashRaw ? JSON.parse(trashRaw) : [];
            const now = Date.now();
            const toTrash = history.map((h: any) => ({...h, deletedAt: now}));
            trash = [...toTrash, ...trash];
            localStorage.setItem('ai_history_trash', JSON.stringify(trash));
          }
        }
        localStorage.removeItem('ai_history');
        (window as any).renderHistory();
      }
    });

    document.getElementById('btn-acessar-lixeira')?.addEventListener('click', () => {
      (window as any).renderTrash();
      document.querySelectorAll('.main-content > .view-section').forEach(s => s.classList.remove('active'));
      const target = document.getElementById('view-lixeira');
      if (target) target.classList.add('active');
