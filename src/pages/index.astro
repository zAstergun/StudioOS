---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

import rankIdeiaSkill from '../skills/rank-de-ideia.md?raw';
import humanizadorSkill from '../skills/humanizador.md?raw';
import titulosSkill from '../skills/titulos.md?raw';
import hooksSkill from '../skills/hooks.md?raw';
import thumbnailSkill from '../skills/thumbnail.md?raw';
import roteiroSkill from '../skills/roteiro.md?raw';
import receitaViralSkill from '../skills/receita-viral.md?raw';
import scorePostSkill from '../skills/score-post.md?raw';
import membrosSkill from '../skills/membros.md?raw';
---

<Layout title="StudioOS">
  <div class="app-layout">

    <!-- ========== MOBILE HEADER ========== -->
    <header class="mobile-header">
      <button class="mobile-menu-btn" id="menu-toggle" aria-label="Abrir menu">
        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="mobile-brand">
        <img src="/logo.svg" alt="StudioOS" class="sidebar-brand-icon" style="width: 28px; height: 28px;" />
        <span style="font-weight: 600; font-size: 14px;">StudioOS</span>
      </div>
      <div style="width: 22px;"></div>
    </header>

    <!-- ========== SIDEBAR OVERLAY ========== -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <!-- ========== SIDEBAR ========== -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <img src="/logo.svg" alt="StudioOS" class="sidebar-brand-icon" width="36" height="36" />
        <div>
          <div class="sidebar-brand-text">StudioOS</div>
          <div class="sidebar-brand-sub">11 ferramentas</div>
        </div>
      </div>

      <div>
        <div class="nav-section-title">Dashboard</div>
        <nav class="nav-menu">
          <div class="nav-item active" data-view="dashboard">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>Visão Geral</span>
          </div>
        </nav>
      </div>

      <div>
        <div class="nav-section-title">Criação</div>
        <nav class="nav-menu">
          <div class="nav-item" data-view="rank-ideia">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>Rank de Ideia</span>
          </div>
          <div class="nav-item" data-view="titulos">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
            <span>Gerador de Títulos</span>
          </div>
          <div class="nav-item" data-view="hooks">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"/></svg>
            <span>Gerador de Hooks</span>
          </div>
          <div class="nav-item" data-view="thumbnail">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Briefing Thumbnail</span>
          </div>
          <div class="nav-item" data-view="roteiro">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            <span>Roteiro & Teleprompter</span>
          </div>
        </nav>
      </div>

      <div>
        <div class="nav-section-title">Publicação</div>
        <nav class="nav-menu">
          <div class="nav-item" data-view="humanizador">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span>Humanizador</span>
          </div>
          <div class="nav-item" data-view="receita-viral">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
            <span>Receita Viral</span>
          </div>
          <div class="nav-item" data-view="score-post">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
            <span>Score de Post</span>
          </div>
        </nav>
      </div>

      <div>
        <div class="nav-section-title">Estratégia</div>
        <nav class="nav-menu">
          <div class="nav-item" data-view="mentor">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span>Mentor AI (24 FW)</span>
          </div>
          <div class="nav-item" data-view="membros">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <span>Área de Membros</span>
          </div>
        </nav>
      </div>

      <div>
        <div class="nav-section-title">Histórico</div>
        <nav class="nav-menu">
          <div class="nav-item" data-view="historico">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Histórico de IA</span>
          </div>
        </nav>
      </div>

      <div>
        <div class="nav-section-title">Ajuda</div>
        <nav class="nav-menu">
          <div class="nav-item" data-view="wiki">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Wiki do Painel</span>
          </div>
        </nav>
      </div>

      <div>
        <div class="nav-section-title">Ajustes</div>
        <nav class="nav-menu">
          <div class="nav-item" data-view="config">
            <svg class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>Configurações</span>
          </div>
        </nav>
      </div>

      <div style="margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border);">
        <div class="badge badge-accent" style="font-size: 10px;">v1.0 — 11 ferramentas</div>
      </div>
    </aside>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="main-content">

      <!-- ================================ -->
      <!-- VIEW: DASHBOARD                  -->
      <!-- ================================ -->
      <div id="view-dashboard" class="view-section active">
        <div class="page-header">
          <h1 class="display">Painel de Conteúdo</h1>
          <p class="text-secondary">Todas as suas ferramentas de criação em um só lugar.</p>
        </div>

        <div class="grid grid-4 mb-32">
          <div class="stat-card">
            <div class="stat-label">Ideias no Banco</div>
            <div class="stat-value" id="stat-ideias">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Roteiros Criados</div>
            <div class="stat-value" id="stat-roteiros">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Posts Avaliados</div>
            <div class="stat-value" id="stat-posts">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Textos Humanizados</div>
            <div class="stat-value" id="stat-humanizados">0</div>
          </div>
        </div>

        <h3 class="title-md mb-20">Ferramentas Rápidas</h3>
        <div class="grid grid-3">
          <div class="card" style="cursor: pointer;" data-goto="rank-ideia">
            <div class="badge badge-accent mb-16">Score 0-10</div>
            <h4 class="card-title">Rank de Ideia</h4>
            <p class="card-description">Avalie ideias de vídeo com régua calibrada no seu canal.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="titulos">
            <div class="badge badge-accent mb-16">Padrões</div>
            <h4 class="card-title">Gerador de Títulos</h4>
            <p class="card-description">Títulos que vencem, calibrados com os dados do canal.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="hooks">
            <div class="badge badge-accent mb-16">6 Variações</div>
            <h4 class="card-title">Gerador de Hooks</h4>
            <p class="card-description">Hooks de 2 linhas com 6 ângulos diferentes.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="roteiro">
            <div class="badge badge-accent mb-16">Teleprompter</div>
            <h4 class="card-title">Roteiro & Gravação</h4>
            <p class="card-description">Roteiros na voz do criador, prontos pro teleprompter.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="humanizador">
            <div class="badge badge-accent mb-16">Anti-IA</div>
            <h4 class="card-title">Humanizador</h4>
            <p class="card-description">Reescreva textos que soam como IA com ritmo humano.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="score-post">
            <div class="badge badge-accent mb-16">Score 0-50</div>
            <h4 class="card-title">Score de Post</h4>
            <p class="card-description">Nota de 0 a 50 em 5 critérios antes de publicar.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="thumbnail">
            <div class="badge badge-accent mb-16">Briefing</div>
            <h4 class="card-title">Briefing Thumbnail</h4>
            <p class="card-description">Composição e briefing de arte calibrados no canal.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="receita-viral">
            <div class="badge badge-accent mb-16">Replicar</div>
            <h4 class="card-title">Receita Viral</h4>
            <p class="card-description">Capture a fórmula de posts que performaram e replique.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="mentor">
            <div class="badge badge-accent mb-16">24 Frameworks</div>
            <h4 class="card-title">Mentor AI</h4>
            <p class="card-description">Pensamento de criador profissional com 24 modelos mentais.</p>
          </div>
          <div class="card" style="cursor: pointer;" data-goto="wiki">
            <div class="badge badge-accent mb-16">Ajuda</div>
            <h4 class="card-title">Wiki do Painel</h4>
            <p class="card-description">Aprenda a usar cada ferramenta e extrair o máximo do painel.</p>
          </div>
        </div>
      </div>

      <!-- ================================ -->
      <!-- VIEW: RANK DE IDEIA              -->
      <!-- ================================ -->
      <div id="view-rank-ideia" class="view-section">
        <div class="page-header">
          <h1 class="display">Rank de Ideia</h1>
          <p class="text-secondary">Avalie vídeos de 0 a 10 com a régua calibrada do seu canal.</p>
        </div>

        <div class="tab-bar">
          <div class="tab-item active" data-tab="rank-calibracao">Calibração</div>
          <div class="tab-item" data-tab="rank-avaliador">Avaliador</div>
        </div>

        <div id="rank-calibracao" class="view-section active">
          <div class="card" style="max-width: 800px;">
            <div class="card-header">
              <h3 class="card-title">Calibração do Canal</h3>
              <p class="card-description">Antes de rankear, precisamos descobrir o padrão do seu canal.</p>
            </div>
            <div class="form-group">
              <label class="form-label">1. Qual o nicho do canal, em 1 frase?</label>
              <input type="text" class="form-control" id="rank-nicho" placeholder="Ex: Finanças para jovens adultos" />
            </div>
            <div class="form-group">
              <label class="form-label">2. Cite 3 vídeos que performaram acima da média e 3 que flopparam.</label>
              <textarea class="form-control" id="rank-videos" placeholder="Acima: 1... 2... 3...\nAbaixo: 1... 2... 3..."></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">3. Qual tipo de vídeo você grava com prova visível na tela?</label>
              <input type="text" class="form-control" id="rank-prova" placeholder="Ex: Demonstração de software, resultados..." />
            </div>
            <div class="form-group">
              <label class="form-label">4. Histórias próprias ou livros que costuma contar?</label>
              <textarea class="form-control" id="rank-historias" placeholder="Liste até 5 histórias recorrentes."></textarea>
            </div>
            <button class="btn btn-primary btn-lg" id="btn-salvar-regua">Salvar Régua do Canal</button>
          </div>
        </div>

        <div id="rank-avaliador" class="view-section">
          <div class="grid grid-2">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">Nova Ideia</h3>
              </div>
              <div class="form-group">
                <label class="form-label">Descreva a ideia do vídeo</label>
                <textarea class="form-control" id="rank-ideia-input" style="min-height: 200px;" placeholder="Ex: Quero falar sobre como economizei 10 mil reais cortando gastos invisíveis..."></textarea>
              </div>
              <button class="btn btn-primary btn-full" id="btn-rankear">Analisar e Rankear</button>
            </div>

            <div class="card flex flex-col items-center" style="justify-content: center; text-align: center;">
              <div id="rank-empty" class="text-secondary">
                <svg style="width: 56px; height: 56px; margin: 0 auto 12px; opacity: 0.4;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                <p>Aguardando ideia para análise...</p>
              </div>
              <div id="rank-result" class="hidden w-full" style="text-align: left;">
                <div class="score-ring" style="margin-bottom: 20px;">
                  <svg width="100" height="100" viewBox="0 0 100 100">
                    <circle class="score-ring-track" cx="50" cy="50" r="44"/>
                    <circle class="score-ring-fill" id="rank-ring" cx="50" cy="50" r="44" stroke-dasharray="276.46" stroke-dashoffset="55.29"/>
                  </svg>
                  <div class="score-ring-value" id="rank-score-text">8</div>
                </div>
                <h3 id="rank-veredito" class="text-center mb-8 text-success">Potencial Alto. Grave isso!</h3>
                <p id="rank-feedback" class="text-secondary text-center mb-24">Essa ideia bate com os pools de atenção.</p>

                <div class="glass-panel mb-20">
                  <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;">Título Sugerido</div>
                  <div id="rank-titulo-sug" style="font-weight: 600; font-size: 16px;">—</div>
                </div>

                <div class="glass-panel mb-24">
                  <div class="text-muted" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;">História Conectada</div>
                  <div id="rank-historia-sug" class="text-secondary" style="font-size: 13px;">—</div>
                </div>

                <div>
                  <h4 class="title-sm mb-8" style="border-bottom: 1px solid var(--border); padding-bottom: 8px;">Breakdown do Score</h4>
                  <div class="breakdown-item"><span class="breakdown-label">Pool de Atenção (0-4)</span><strong class="breakdown-value" id="brk-pool">—</strong></div>
                  <div class="breakdown-item"><span class="breakdown-label">Prova Visível (0-2)</span><strong class="breakdown-value" id="brk-prova">—</strong></div>
                  <div class="breakdown-item"><span class="breakdown-label">Conexão Pessoal (0-2)</span><strong class="breakdown-value" id="brk-conexao">—</strong></div>
                  <div class="breakdown-item"><span class="breakdown-label">Fit de Título (0-1)</span><strong class="breakdown-value" id="brk-fit">—</strong></div>
                  <div class="breakdown-item"><span class="breakdown-label">Outlier de Mercado (0-1)</span><strong class="breakdown-value" id="brk-outlier">—</strong></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ================================ -->
      <!-- VIEW: GERADOR DE TÍTULOS         -->
      <!-- ================================ -->
      <div id="view-titulos" class="view-section">
        <div class="page-header">
          <h1 class="display">Gerador de Títulos</h1>
          <p class="text-secondary">Títulos que vencem no canal, calibrados com o dado real.</p>
        </div>

        <div class="grid grid-2">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Calibração de Títulos</h3>
              <p class="card-description">Os padrões que vencem no seu canal.</p>
            </div>
            <div class="form-group">
              <label class="form-label">5 títulos que mais performaram</label>
              <textarea class="form-control" id="tit-tops" placeholder="1. ...\n2. ...\n3. ...\n4. ...\n5. ..."></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">5 que flopparam</label>
              <textarea class="form-control" id="tit-flops" placeholder="1. ...\n2. ...\n3. ...\n4. ...\n5. ..."></textarea>
            </div>
            <div class="form-group">
              <label class="form-label">CTR Médio do Canal</label>
              <input type="text" class="form-control" id="tit-ctr" placeholder="Ex: 4.5%" />
            </div>
            <div class="form-group">
              <label class="form-label">Tema do vídeo</label>
              <input type="text" class="form-control" id="tit-tema" placeholder="Ex: Investir em FIIs com 100 reais" />
            </div>
            <button class="btn btn-primary btn-full" id="btn-gerar-titulos">Gerar Títulos</button>
          </div>

          <div class="card" id="titulos-resultado">
            <div class="card-header">
              <h3 class="card-title">Títulos Gerados</h3>
              <p class="card-description">4 padrões validados por dados reais.</p>
            </div>
            <div class="glass-panel mb-16">
              <div class="badge badge-success mb-8">Recomendado</div>
              <div style="font-weight: 600; font-size: 16px; margin-top: 8px;">Eu parei de investir R$100 em FIIs</div>
              <p class="text-secondary mt-8" style="font-size: 12px;">Padrão: 1ª pessoa + verbo de ação + consequência</p>
            </div>
            <div class="glass-panel mb-16">
              <div style="font-weight: 500;">R$100 em FIIs não vale mais a pena</div>
              <p class="text-secondary mt-8" style="font-size: 12px;">Padrão: Mudança + urgência</p>
            </div>
            <div class="glass-panel mb-16">
              <div style="font-weight: 500;">Perdi 2 anos investindo R$100 por mês</div>
              <p class="text-secondary mt-8" style="font-size: 12px;">Padrão: Confissão com humor</p>
            </div>
            <div class="glass-panel">
              <div style="font-weight: 500;">3 investimentos melhores que FIIs com R$100</div>
              <p class="text-secondary mt-8" style="font-size: 12px;">Padrão: Número específico + sistema</p>
            </div>
          </div>
        </div>
      </div>

