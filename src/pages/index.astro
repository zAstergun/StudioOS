          </div>
          <div style="display: flex; gap: 12px; align-items: center;">
            <button class="btn btn-primary" id="btn-save-key">Salvar Configurações</button>
            <button class="btn" id="btn-test-key" style="background: var(--bg-elevated); border: 1px solid var(--border);">Testar Conexão</button>
          </div>
