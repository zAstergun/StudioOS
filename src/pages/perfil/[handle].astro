---
import Layout from '../../layouts/Layout.astro';
import StudioClient from '../../studio/StudioClient';

const handle = Astro.params.handle;
const cleanHandle = handle ? handle.replace(/^@/, '') : '';
const title = cleanHandle ? `@${cleanHandle} — StudioOS` : "Perfil — StudioOS";
---

<Layout title={title}>
  <StudioClient client:only="react" />
</Layout>
