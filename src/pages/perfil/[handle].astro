---
import { createSupabaseClient } from '../../studio/lib/supabase';
import Layout from '../../layouts/Layout.astro';
// @ts-ignore
import { env as cfEnv } from "cloudflare:workers";

const handle = Astro.params.handle;

if (!handle) {
  return new Response("Não encontrado", { status: 404 });
}

const channelStr = handle.startsWith('@') ? handle.substring(1) : handle;

const env = cfEnv || import.meta.env;
const supabaseUrl = env.PUBLIC_SUPABASE_URL || import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let profile: any = null;
let ongoingProjects: any[] = [];
let featuredVideoProject: any = null;
let featuredVideoTitle = "Vídeo em Destaque";

if (supabaseUrl && supabaseKey) {
  const supabase = createSupabaseClient(Astro.cookies, supabaseUrl, supabaseKey);
  const { data, error } = await supabase.from('profiles').select('*').eq('channel', channelStr).single();
  if (error) {
    console.error("Supabase Error finding profile by channel:", error);
  }
  profile = data;

  if (profile) {
    const cardVis = profile.card_visibility || { stats: true, projects: true, video: true, achievements: true };
    
    // Busca projetos se o card de projetos ou vídeo estiver ativo
    if (cardVis.projects !== false || cardVis.video !== false) {
      const { data: projs } = await supabase
        .from('studioos_projects')
        .select('id, name, status, progress, color, external_link, studioos_tasks(status)')
        .eq('owner_id', profile.id)
        .order('created_at', { ascending: false });

      if (projs) {
        const statusMap: Record<string, string> = {
          active: "Em andamento",
          planning: "Planejamento",
          completed: "Concluído",
          archived: "Arquivado",
          trashed: "Lixeira"
        };
        ongoingProjects = projs
          .filter((p: any) => p.status === 'active' || p.status === 'planning' || p.status === 'Em andamento')
          .map((p: any) => {
            const tasks = p.studioos_tasks || [];
            const totalTasks = tasks.length;
            const doneTasks = tasks.filter((t: any) => t.status === "done").length;
            const calculatedProgress = totalTasks > 0 ? Math.round((doneTasks / totalTasks) * 100) : (p.progress || 0);
            return {
              ...p,
              status: statusMap[p.status] || p.status,
              progress: calculatedProgress
            };
          });

        const videoProjs = projs.filter((p: any) => p.external_link && p.external_link.trim() !== "");
        if (profile.featured_video?.id) {
          featuredVideoProject = videoProjs.find((p: any) => p.id === profile.featured_video.id) || videoProjs[0];
          featuredVideoTitle = profile.featured_video.title || "Vídeo em Destaque";
        } else if (videoProjs.length > 0) {
          featuredVideoProject = videoProjs[0];
        }
      }
    }
  }
} else {
  // Mock para demonstração local
  profile = {
    id: "demo-user",
    full_name: "Aster Criador",
    channel: channelStr,
    avatar_url: null,
    bio: "Criador de conteúdo usando o StudioOS. Transformando ideias cruas em projetos publicados com o auxílio de ferramentas conectadas e com número e critério em cada etapa.",
    links: {
      website: "aster.studio",
      youtube: "youtube.com/@aster",
      instagram: "instagram.com/aster",
      tiktok: "tiktok.com/@aster",
      discord: "discord.gg/aster"
    },
    card_visibility: {
      stats: true,
      projects: true,
      video: true,
      achievements: true
    },
    stats: {
      total_runs: 128,
      ideias_ranqueadas: 214,
      projetos: 14,
      streak: 21
    }
  };
  ongoingProjects = [
    { id: "1", name: "Doc: Origem dos Dados", status: "Em andamento", progress: 68, color: "#F2604C", external_link: "https://youtube.com" },
    { id: "2", name: "Guia StudioOS 2026", status: "Planejamento", progress: 35, color: "#6E93F5" },
    { id: "3", name: "Podcast Corte #04", status: "Em andamento", progress: 90, color: "#2FD4A0" },
  ];
  featuredVideoProject = {
    id: "1",
    name: "Doc: Origem dos Dados",
    status: "Em andamento",
    external_link: "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
  };
}

if (!profile) {
  return new Response("Perfil não encontrado", { status: 404 });
}

const cardVis = profile.card_visibility || { stats: true, projects: true, video: true, achievements: true };
const userStats = profile.stats || {};
const links = profile.links || {};

function getEmbedUrl(url?: string) {
  if (!url) return null;
  try {
    const trimmed = url.trim();
    const ytMatch = trimmed.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
    if (ytMatch && ytMatch[1]) {
      return `https://www.youtube.com/embed/${ytMatch[1]}?autoplay=0&rel=0`;
    }
    const vimeoMatch = trimmed.match(/vimeo\.com\/(?:video\/)?(\d+)/);
    if (vimeoMatch && vimeoMatch[1]) {
      return `https://player.vimeo.com/video/${vimeoMatch[1]}`;
    }
    const tiktokMatch = trimmed.match(/tiktok\.com\/.*video\/(\d+)/);
    if (tiktokMatch && tiktokMatch[1]) {
      return `https://www.tiktok.com/embed/v2/${tiktokMatch[1]}`;
    }
    if (trimmed.includes("instagram.com/")) {
      const path = trimmed.split("instagram.com/")[1].split("?")[0].replace(/\/$/, "");
      if (path.startsWith("p/") || path.startsWith("reel/")) {
        return `https://www.instagram.com/${path}/embed`;
      }
    }
    if (trimmed.endsWith(".mp4") || trimmed.endsWith(".webm")) {
      return trimmed;
    }
  } catch (e) {
    return null;
  }
  return null;
}

const achievements = [
  { id: "seq21", icon: "spark", label: "Sequência de 21 dias", desc: "Acessou o painel por 21 dias seguidos.", tone: "text-[#F2B33D]", bg: "bg-[#F2B33D]/10", hex: "#F2B33D", unlocked: Number(userStats['streak'] || 21) >= 21 },
  { id: "ideias200", icon: "target", label: "200 ideias ranqueadas", desc: "Mais de 200 ideias processadas no painel.", tone: "text-[#2FD4A0]", bg: "bg-[#2FD4A0]/10", hex: "#2FD4A0", unlocked: Number(userStats['ideias_ranqueadas'] || 214) >= 200 },
  { id: "top4", icon: "star", label: "Top 4% do canal", desc: "Seu desempenho superou 96% dos criadores.", tone: "text-[#6E93F5]", bg: "bg-[#6E93F5]/10", hex: "#6E93F5", unlocked: Number(userStats['top4'] || 1) === 1 },
  { id: "verified", icon: "check", label: "Conta verificada", desc: "Identidade confirmada com sucesso.", tone: "text-[#F2604C]", bg: "bg-[#F2604C]/10", hex: "#F2604C", unlocked: true },
];

const unlockedAchievements = achievements.filter(a => a.unlocked);
const featuredEmbedUrl = featuredVideoProject ? getEmbedUrl(featuredVideoProject.external_link) : null;
const hasAnyPublicCard = cardVis.stats !== false || (cardVis.projects !== false && ongoingProjects.length > 0) || (cardVis.video !== false && !!featuredEmbedUrl) || (cardVis.achievements !== false && unlockedAchievements.length > 0);
---

<Layout title={`${profile.full_name} (@${profile.channel}) · Perfil StudioOS`}>
  <div class="min-h-screen bg-ink-950 text-bone-100 flex flex-col relative selection:bg-signal-400 selection:text-ink-950 pb-20">
    <!-- Top ambient glow -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-signal-400/5 via-transparent to-transparent blur-[140px] pointer-events-none -z-10"></div>

    <!-- Header bar -->
    <header class="border-b border-[#232327]/80 bg-[#0c0c0e]/80 backdrop-blur-md sticky top-0 z-40 px-6 py-3.5">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="h-7 w-7 rounded-lg bg-signal-400 flex items-center justify-center text-ink-950 font-display font-extrabold text-sm shadow-[0_0_15px_rgba(242,179,61,0.3)] group-hover:scale-105 transition-transform">
            S
          </div>
          <span class="font-display font-bold tracking-tight text-bone-50 text-[15px]">StudioOS</span>
          <span class="text-[10px] font-mono tracking-widest uppercase text-signal-400/80 bg-signal-400/10 border border-signal-400/20 px-1.5 py-0.5 rounded ml-1">Perfil Público</span>
        </a>
        <a href="/" class="flex items-center gap-2 rounded-lg bg-[#18181b] border border-[#27272a] px-3.5 py-1.5 text-[11px] font-semibold text-bone-200 hover:text-white hover:border-signal-400/50 hover:bg-[#202024] transition-all">
          <span>Criar meu estúdio</span>
          <span class="text-signal-400 font-mono">→</span>
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl w-full mx-auto px-4 sm:px-6 pt-10">
      
      {/* Profile Header Card */}
      <div class="rounded-2xl border border-[#232327] bg-[#0c0c0e]/95 p-6 sm:p-8 backdrop-blur-md shadow-2xl mb-8 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-signal-400 via-[#2FD4A0] to-[#6E93F5] opacity-70"></div>
        
        <div class="flex flex-col lg:flex-row items-start gap-6 sm:gap-8">
          <!-- Avatar -->
          <div class="relative shrink-0">
            <div class="relative h-28 w-28 sm:h-32 sm:w-32 overflow-hidden rounded-full border-2 border-signal-400 bg-ink-900 shadow-[0_12px_30px_rgba(0,0,0,0.6)]">
              {profile.avatar_url ? (
                <img src={profile.avatar_url} alt={profile.full_name} class="h-full w-full object-cover" />
              ) : (
                <img src={`https://ui-avatars.com/api/?name=${encodeURIComponent(profile.full_name)}&background=random`} alt={profile.full_name} class="h-full w-full object-cover" />
              )}
            </div>
            <div class="absolute -bottom-1 -right-1 h-7 w-7 rounded-full bg-signal-400 text-ink-950 flex items-center justify-center font-bold text-xs shadow-lg" title="Verificado StudioOS">
              ✓
            </div>
          </div>

          <!-- Info -->
          <div class="min-w-0 flex-1">
            <div class="flex flex-col gap-1.5 mb-2">
              <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-bone-50">
                  {profile.full_name}
                </h1>
                <span class="flex items-center gap-1 rounded-full border border-signal-400/35 bg-signal-400/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.11em] text-signal-400 shrink-0">
                  Verificado
                </span>
              </div>
              <div class="flex items-center gap-2">
                <span class="font-mono text-sm text-signal-400 font-semibold">
                  @{profile.channel}
                </span>
              </div>
            </div>

            <!-- Bio -->
            <p class="mt-2.5 max-w-[68ch] text-[14px] leading-relaxed text-bone-300">
              {profile.bio || "Criador de conteúdo usando o StudioOS. Transformando ideias cruas em projetos publicados com o auxílio de ferramentas conectadas e com número e critério em cada etapa."}
            </p>

            <!-- Counters -->
            <div class="mt-5 flex flex-wrap items-center gap-x-7 gap-y-2">
              <div class="flex items-baseline gap-2">
                <span class="font-display text-[16px] font-bold text-bone-50 tabular-nums">{userStats.projetos ?? ongoingProjects.length}</span>
                <span class="text-[10px] font-mono tracking-widest text-ink-400 uppercase">{(userStats.projetos ?? ongoingProjects.length) === 1 ? 'projeto' : 'projetos'}</span>
              </div>
              <div class="flex items-baseline gap-2">
                <span class="font-display text-[16px] font-bold text-bone-50 tabular-nums">{userStats.ideias_ranqueadas ?? 0}</span>
                <span class="text-[10px] font-mono tracking-widest text-ink-400 uppercase">ideias ranqueadas</span>
              </div>
              <div class="flex items-baseline gap-2">
                <span class="font-display text-[16px] font-bold text-bone-50 tabular-nums">
                  {(() => {
                    if (!userStats.avg_rating) return "-";
                    const match = String(userStats.avg_rating).match(/([\d.]+)\/5/);
                    if (match) {
                      const n = parseFloat(match[1]);
                      if (!isNaN(n) && n > 5) return `${Math.min(5, (n / 10)).toFixed(1)}/5`;
                    }
                    return userStats.avg_rating;
                  })()}
                </span>
                <span class="text-[10px] font-mono tracking-widest text-ink-400 uppercase">nota média</span>
              </div>
            </div>

            <!-- Social Links -->
            {(links.website || links.youtube || links.instagram || links.tiktok || links.discord) && (
              <div class="mt-5 flex flex-wrap items-center gap-2.5">
                {links.website && (
                  <a href={links.website.startsWith('http') ? links.website : `https://${links.website}`} target="_blank" rel="noreferrer" class="group flex items-center gap-2 rounded-full border border-[#232327] bg-[#101012] px-3.5 py-1.5 text-[12px] font-medium text-[#a8a8b0] transition-all hover:border-[#F2B33D]/50 hover:bg-[#F2B33D]/5 hover:text-[#F2B33D] hover:shadow-[0_0_12px_rgba(242,179,61,0.15)]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 shrink-0 text-[#8c8c94] transition-colors group-hover:text-[#F2B33D]">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                      <path d="M2 12h20"></path>
                    </svg>
                    <span>{links.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
                  </a>
                )}
                {links.youtube && (
                  <a href={links.youtube.startsWith('http') ? links.youtube : `https://${links.youtube}`} target="_blank" rel="noreferrer" class="group flex items-center gap-2 rounded-full border border-[#232327] bg-[#101012] px-3.5 py-1.5 text-[12px] font-medium text-[#a8a8b0] transition-all hover:border-[#FF0000]/50 hover:bg-[#FF0000]/5 hover:text-[#FF0000] hover:shadow-[0_0_12px_rgba(255,0,0,0.15)]">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 shrink-0 text-[#8c8c94] transition-colors group-hover:text-[#FF0000]">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                    <span>YouTube</span>
                  </a>
                )}
                {links.instagram && (
                  <a href={links.instagram.startsWith('http') ? links.instagram : `https://${links.instagram}`} target="_blank" rel="noreferrer" class="group flex items-center gap-2 rounded-full border border-[#232327] bg-[#101012] px-3.5 py-1.5 text-[12px] font-medium text-[#a8a8b0] transition-all hover:border-[#E1306C]/50 hover:bg-[#E1306C]/5 hover:text-[#E1306C] hover:shadow-[0_0_12px_rgba(225,48,108,0.15)]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 shrink-0 text-[#8c8c94] transition-colors group-hover:text-[#E1306C]">
                      <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                      <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                    </svg>
                    <span>Instagram</span>
                  </a>
                )}
                {links.tiktok && (
                  <a href={links.tiktok.startsWith('http') ? links.tiktok : `https://${links.tiktok}`} target="_blank" rel="noreferrer" class="group flex items-center gap-2 rounded-full border border-[#232327] bg-[#101012] px-3.5 py-1.5 text-[12px] font-medium text-[#a8a8b0] transition-all hover:border-[#00f2fe]/50 hover:bg-[#00f2fe]/5 hover:text-[#00f2fe] hover:shadow-[0_0_12px_rgba(0,242,254,0.15)]">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 shrink-0 text-[#8c8c94] transition-colors group-hover:text-[#00f2fe]">
                      <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.5 6.34 6.34 0 0 0 1.96-4.54V9.06a8.28 8.28 0 0 0 4.81 1.55v-3.44a4.85 4.85 0 0 1-1-.48z"/>
                    </svg>
                    <span>TikTok</span>
                  </a>
                )}
                {links.discord && (
                  <a href={links.discord.startsWith('http') ? links.discord : `https://${links.discord}`} target="_blank" rel="noreferrer" class="group flex items-center gap-2 rounded-full border border-[#232327] bg-[#101012] px-3.5 py-1.5 text-[12px] font-medium text-[#a8a8b0] transition-all hover:border-[#5865F2]/50 hover:bg-[#5865F2]/5 hover:text-[#5865F2] hover:shadow-[0_0_12px_rgba(88,101,242,0.15)]">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 shrink-0 text-[#8c8c94] transition-colors group-hover:text-[#5865F2]">
                      <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                    </svg>
                    <span>Discord</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      {/* Cards Grid according to card_visibility */}
      {hasAnyPublicCard ? (
        <div class="grid gap-6 lg:grid-cols-[1fr_340px]">
          
          <!-- Coluna Esquerda: Estatísticas de Uso -->
          <div class="flex flex-col gap-6">
            {cardVis.stats !== false && (
              <div class="rounded-2xl border border-[#232327] bg-[#0c0c0e] overflow-hidden shadow-xl">
                {/* Header: Monitor de uso */}
                <div class="flex items-center gap-3 border-b border-[#232327] px-5 py-3.5 bg-[#0a0a0c]">
                  <span class="flex gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-[#F2604C]"></span>
                    <span class="h-2 w-2 rounded-full bg-[#F2B33D]"></span>
                    <span class="h-2 w-2 rounded-full bg-[#2FD4A0]"></span>
                  </span>
                  <span class="flex-1 text-center font-mono text-[10px] uppercase tracking-widest text-[#9a9aa2]">
                    Monitor de uso de estúdio · 12 semanas
                  </span>
                  <span class="font-mono text-[10px] uppercase tracking-widest text-[#2FD4A0]">
                    ● Ao vivo
                  </span>
                </div>

                {/* Gráfico de Barras */}
                <div class="px-5 pb-5 pt-4">
                  <div class="flex h-[100px] items-end gap-[3px]">
                    {(() => {
                      const days56 = Array.isArray(userStats.days_56) ? userStats.days_56 : Array(56).fill(0);
                      const maxAction = Math.max(...days56, 1);
                      return days56.map((count: number, i: number) => {
                        const hasRun = count > 0;
                        const intensity = hasRun ? count / maxAction : 0;
                        const color = hasRun
                          ? (intensity > 0.7 ? "#F2604C" : intensity > 0.35 ? "#F2B33D" : "#2FD4A0")
                          : "#1c1c20";
                        const h = hasRun ? Math.max(18, Math.round(intensity * 100)) : 6;
                        return (
                          <div 
                            class="flex-1 rounded-full hover:opacity-100 transition-opacity" 
                            style={`height: ${h}%; background: ${color}; opacity: ${hasRun ? 0.95 : 0.4};`}
                            title={`Dia ${i + 1}: ${count} ações`}
                          />
                        );
                      });
                    })()}
                  </div>
                  <div class="mt-2.5 flex items-center justify-between text-[10px] font-mono uppercase tracking-widest text-[#8c8c94]">
                    <span>Atividade recente</span>
                    <span>{userStats.total_runs ? `${userStats.total_runs} execuções registradas` : 'Tempo real'}</span>
                    <span>Hoje</span>
                  </div>
                </div>

                {/* 2x2 Métricas */}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-px border-t border-[#232327] bg-[#232327]">
                  <div class="bg-[#101012] px-5 py-4">
                    <div class="text-[10px] font-mono uppercase tracking-widest text-[#8c8c94]">USO DE FERRAMENTAS</div>
                    <div class="mt-2 flex items-baseline justify-between">
                      <span class="font-display text-2xl font-bold text-[#2FD4A0]">{userStats['total_runs'] ?? 0}</span>
                      <span class="rounded bg-[#2FD4A0]/10 text-[#2FD4A0] px-1.5 py-0.5 text-[10px] font-mono">Execuções</span>
                    </div>
                  </div>
                  <div class="bg-[#101012] px-5 py-4">
                    <div class="text-[10px] font-mono uppercase tracking-widest text-[#8c8c94]">HORAS EM ESTÚDIO</div>
                    <div class="mt-2 flex items-baseline justify-between">
                      <span class="font-display text-2xl font-bold text-[#2FD4A0]">{Math.floor((userStats['studio_minutes'] ?? 0) / 60)}h {(userStats['studio_minutes'] ?? 0) % 60}m</span>
                      <span class="rounded bg-[#2FD4A0]/10 text-[#2FD4A0] px-1.5 py-0.5 text-[10px] font-mono">Estúdio</span>
                    </div>
                  </div>
                  <div class="bg-[#101012] px-5 py-4">
                    <div class="text-[10px] font-mono uppercase tracking-widest text-[#8c8c94]">IDEIAS RANQUEADAS</div>
                    <div class="mt-2 flex items-baseline justify-between">
                      <span class="font-display text-2xl font-bold text-[#F2604C]">{userStats['ideias_ranqueadas'] ?? 0}</span>
                      <span class="rounded bg-[#F2604C]/10 text-[#F2604C] px-1.5 py-0.5 text-[10px] font-mono">Ranqueadas</span>
                    </div>
                  </div>
                  <div class="bg-[#101012] px-5 py-4">
                    <div class="text-[10px] font-mono uppercase tracking-widest text-[#8c8c94]">SEQUÊNCIA ATUAL</div>
                    <div class="mt-2 flex items-baseline justify-between">
                      <span class="font-display text-2xl font-bold text-[#F2B33D]">{userStats['streak'] || 1} {userStats['streak'] === 1 ? 'dia' : 'dias'}</span>
                      <span class="rounded bg-[#F2B33D]/10 text-[#F2B33D] px-1.5 py-0.5 text-[10px] font-mono">Ativo</span>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>

          <!-- Coluna Direita: Projetos, Vídeo & Conquistas -->
          <aside class="space-y-6">
            
            {/* Projetos em Andamento */}
            {cardVis.projects !== false && ongoingProjects.length > 0 && (
              <div class="rounded-2xl border border-[#232327] bg-[#0c0c0e] overflow-hidden shadow-xl">
                <div class="flex items-center gap-3 border-b border-[#232327] px-4 py-3.5 bg-[#0a0a0c]">
                  <span class="h-3.5 w-1 rounded-full bg-[#2FD4A0]"></span>
                  <h3 class="flex-1 font-display text-[15px] font-bold text-white tracking-tight">Projetos em Andamento</h3>
                  <span class="font-mono text-[10px] text-[#8c8c94] tracking-widest">{ongoingProjects.length}</span>
                </div>
                <div class="p-5 space-y-4">
                  {ongoingProjects.map((proj) => (
                    <div>
                      <div class="flex justify-between items-center mb-1.5">
                        <div class="flex items-center gap-2">
                          <span class="text-[13px] font-medium text-[#d3d3d8]">{proj.name}</span>
                          {proj.external_link && (
                            <a href={proj.external_link} target="_blank" rel="noopener noreferrer" class="text-[#8c8c94] hover:text-[#6E93F5] transition-colors" title="Acessar projeto">
                              ↗
                            </a>
                          )}
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="text-[11px] font-mono font-bold text-bone-100 tabular-nums">{proj.progress}%</span>
                          <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-ink-900 border border-[#232327] text-[#8c8c94] uppercase tracking-wider">{proj.status}</span>
                        </div>
                      </div>
                      <div class="h-1.5 w-full bg-[#1c1c20] rounded-full overflow-hidden">
                        <div class="h-full rounded-full transition-all duration-700 ease-out" style={`width: ${Math.max(proj.progress, 3)}%; background-color: ${proj.color || '#2FD4A0'};`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Vídeo em Destaque */}
            {cardVis.video !== false && featuredEmbedUrl && (
              <div class="rounded-2xl border border-[#232327] bg-[#0c0c0e] overflow-hidden shadow-xl">
                <div class="flex items-center gap-3 border-b border-[#232327] px-4 py-3.5 bg-[#0a0a0c]">
                  <span class="h-3.5 w-1 rounded-full bg-[#6E93F5]"></span>
                  <h3 class="flex-1 font-display text-[15px] font-bold text-white tracking-tight truncate">
                    {featuredVideoTitle}
                  </h3>
                </div>
                <div class="relative w-full aspect-video bg-[#050507]">
                  <iframe 
                    src={featuredEmbedUrl} 
                    class="w-full h-full" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                  ></iframe>
                </div>
                {featuredVideoProject && (
                  <div class="p-3 bg-[#0a0a0c] border-t border-[#232327] flex items-center justify-between">
                    <span class="text-[12px] font-medium text-[#d3d3d8] truncate">{featuredVideoProject.name}</span>
                    {featuredVideoProject.external_link && (
                      <a href={featuredVideoProject.external_link} target="_blank" rel="noreferrer" class="text-[11px] font-mono text-[#6E93F5] hover:underline">
                        Abrir link ↗
                      </a>
                    )}
                  </div>
                )}
              </div>
            )}

            {/* Conquistas do Estúdio */}
            {cardVis.achievements !== false && unlockedAchievements.length > 0 && (
              <div class="rounded-2xl border border-[#232327] bg-[#0c0c0e] overflow-hidden shadow-xl">
                <div class="flex items-center gap-3 border-b border-[#232327] px-4 py-3.5 bg-[#0a0a0c]">
                  <span class="h-3.5 w-1 rounded-full bg-[#F2B33D]"></span>
                  <h3 class="flex-1 font-display text-[15px] font-bold text-white tracking-tight">Conquistas do Criador</h3>
                  <span class="font-mono text-[10px] text-[#8c8c94] tracking-widest">{unlockedAchievements.length}</span>
                </div>
                <div class="p-5 grid grid-cols-2 gap-3">
                  {unlockedAchievements.map((a) => (
                    <div class="rounded-xl border border-[#232327] bg-[#101012] p-3 flex flex-col items-start gap-2">
                      <div class={`rounded-md p-1.5 ${a.bg} ${a.tone} text-xs font-bold`}>
                        ★
                      </div>
                      <div>
                        <div class="text-[12px] font-semibold text-white tracking-tight leading-snug">{a.label}</div>
                        <div class="text-[10px] text-[#8c8c94] mt-0.5 leading-tight">{a.desc}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </aside>
        </div>
      ) : (
        <div class="rounded-2xl border border-[#232327] bg-[#0c0c0e] p-12 text-center text-[#8c8c94] max-w-lg mx-auto">
          <p class="text-[14px]">Este criador optou por manter os cards do estúdio privados no momento.</p>
        </div>
      )}

      {/* Footer Banner */}
      <footer class="mt-16 text-center border-t border-[#232327] pt-8 pb-4">
        <p class="text-[12px] text-[#8c8c94]">
          StudioOS · Painel de Gestão e Criação de Conteúdo Digital
        </p>
      </footer>
    </main>
  </div>
</Layout>
